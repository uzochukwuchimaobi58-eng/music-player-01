rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Affiliate Products Feed - Publicly readable by all app users worldwide
    match /affiliate_products/{productId} {
      allow read: if true;
      allow write: if request.resource.data.id is string
                   && request.resource.data.title is string
                   && request.resource.data.price is string
                   && request.resource.data.affiliateUrl is string;
      allow delete: if true;
    }

    // Global Affiliate Configuration
    match /affiliate_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
