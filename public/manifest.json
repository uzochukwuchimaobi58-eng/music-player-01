{
  "id": "/",
  "name": "Music Player",
  "short_name": "Music Player",
  "description": "High-Fidelity Offline Music Player with auto-detect downloads, 10-band equalizer, and synchronized lyrics.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#050505",
  "theme_color": "#121212",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Audio track",
      "accept": {
        "audio/*": [".mp3", ".wav", ".ogg", ".flac", ".m4a", ".aac", ".opus"]
      }
    }
  ]
}
